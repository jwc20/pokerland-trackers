<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pokerland.Tracker.App</RootNamespace>
    <AssemblyName>PokerlandTracker</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Users do not need .NET installed: `dotnet publish` bundles the runtime (see build.ps1). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pokerland.Tracker.Core\Pokerland.Tracker.Core.csproj" />
  </ItemGroup>

</Project>
