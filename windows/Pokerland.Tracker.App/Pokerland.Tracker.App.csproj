<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pokerland.Tracker.App</RootNamespace>
    <AssemblyName>PokerlandTracker</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Users do not need .NET installed: `dotnet publish` bundles the runtime (see build.ps1). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The default server comes from the repo's .env.<PokerlandEnv> file, shared with
    the macOS tracker: .env.local for Debug builds, .env.production for Release
    builds (what build.ps1 ships). Override with -p:PokerlandEnv=local|production.
    AppSettings reads it back from the assembly's metadata.
  -->
  <PropertyGroup>
    <PokerlandEnv Condition="'$(PokerlandEnv)' == '' and '$(Configuration)' == 'Release'">production</PokerlandEnv>
    <PokerlandEnv Condition="'$(PokerlandEnv)' == ''">local</PokerlandEnv>
    <PokerlandEnvFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\.env.$(PokerlandEnv)'))</PokerlandEnvFile>
    <PokerlandApiBaseUrl Condition="Exists('$(PokerlandEnvFile)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(PokerlandEnvFile)')), '(?ms)\A.*?^POKERLAND_API_BASE_URL=([^\r\n]*).*\z', '$1').Trim())</PokerlandApiBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PokerlandApiBaseUrl" Value="$(PokerlandApiBaseUrl)" />
  </ItemGroup>

  <Target Name="CheckPokerlandEnv" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PokerlandEnvFile)')" Text="$(PokerlandEnvFile) not found: PokerlandEnv must be local or production." />
    <Error Condition="!$(PokerlandApiBaseUrl.StartsWith('http'))" Text="$(PokerlandEnvFile) does not set POKERLAND_API_BASE_URL to an http(s) URL." />
    <Message Importance="high" Text="Pokerland tracker ($(PokerlandEnv)): $(PokerlandApiBaseUrl)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pokerland.Tracker.Core\Pokerland.Tracker.Core.csproj" />
  </ItemGroup>

</Project>
