<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pokerland.Tracker.App</RootNamespace>
    <AssemblyName>PokerlandTracker</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Users do not need .NET installed: `dotnet publish` bundles the runtime (see build.ps1). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The default server: production for Release builds (what build.ps1 ships;
    AppSettings has the URL), a local server (http://127.0.0.1:8000) for Debug
    builds. Override with -p:PokerlandEnv=local|production. An optional,
    untracked .env.<PokerlandEnv> file at the repo root, shared with the macOS
    tracker, or -p:PokerlandApiBaseUrl=... replaces that environment's URL.
    AppSettings reads it back from the assembly's metadata.
  -->
  <PropertyGroup>
    <PokerlandEnv Condition="'$(PokerlandEnv)' == '' and '$(Configuration)' == 'Release'">production</PokerlandEnv>
    <PokerlandEnv Condition="'$(PokerlandEnv)' == ''">local</PokerlandEnv>
    <PokerlandEnvFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\.env.$(PokerlandEnv)'))</PokerlandEnvFile>
    <PokerlandApiBaseUrl Condition="'$(PokerlandApiBaseUrl)' == '' and Exists('$(PokerlandEnvFile)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(PokerlandEnvFile)')), '(?ms)\A.*?^POKERLAND_API_BASE_URL=([^\r\n]*).*\z', '$1').Trim())</PokerlandApiBaseUrl>
    <PokerlandApiBaseUrl Condition="'$(PokerlandApiBaseUrl)' == '' and '$(PokerlandEnv)' == 'local'">http://127.0.0.1:8000</PokerlandApiBaseUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(PokerlandApiBaseUrl)' != ''">
    <AssemblyMetadata Include="PokerlandApiBaseUrl" Value="$(PokerlandApiBaseUrl)" />
  </ItemGroup>

  <Target Name="CheckPokerlandEnv" BeforeTargets="BeforeBuild">
    <Error Condition="'$(PokerlandEnv)' != 'local' and '$(PokerlandEnv)' != 'production'" Text="PokerlandEnv must be local or production, not '$(PokerlandEnv)'." />
    <Error Condition="'$(PokerlandApiBaseUrl)' != '' and !$(PokerlandApiBaseUrl.StartsWith('http'))" Text="POKERLAND_API_BASE_URL is not an http(s) URL; check $(PokerlandEnvFile)." />
    <Message Importance="high" Condition="'$(PokerlandApiBaseUrl)' != ''" Text="Pokerland tracker ($(PokerlandEnv)): $(PokerlandApiBaseUrl)" />
    <Message Importance="high" Condition="'$(PokerlandApiBaseUrl)' == ''" Text="Pokerland tracker ($(PokerlandEnv)): built-in production URL" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pokerland.Tracker.Core\Pokerland.Tracker.Core.csproj" />
  </ItemGroup>

</Project>
